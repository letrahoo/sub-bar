<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.letra.subbar-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/__USER__/.local/share/sub-cost-view/subbar-server</string>
    <string>-addr</string>
    <string>127.0.0.1:8328</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/__USER__/Library/Logs/subbar-server.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/__USER__/Library/Logs/subbar-server.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
