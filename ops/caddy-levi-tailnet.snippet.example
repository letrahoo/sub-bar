# Append to ~/.config/caddy/levi-services-tailnet.caddy (0600, runtime-only, do not commit real host/email)
# Tailscale Serve: tailscale serve --bg --https=8448 http://127.0.0.1:8093

http://<mac-mini-host>.<tailnet>.ts.net:8093 {
	bind 127.0.0.1
	import private_headers

	@tailnet_unauthorized not header Tailscale-User-Login <your-tailscale-login>
	@cross_site header Sec-Fetch-Site cross-site
	@foreign_origin {
		header Origin *
		not header Origin https://<mac-mini-host>.<tailnet>.ts.net:8448
	}

	route {
		respond @cross_site 403
		respond @foreign_origin 403
		respond @tailnet_unauthorized 403
		reverse_proxy 127.0.0.1:8328 {
			header_up Host 127.0.0.1:8328
			header_up X-Forwarded-Proto https
			header_up -Origin
			header_up -Tailscale-User-Login
			header_up -Tailscale-User-Name
			header_up -Tailscale-User-Profile-Pic
		}
	}
}

# Entry in ~/.config/levi-remote/services.json:
# {
#   "id": "sub-cost",
#   "name": "订阅与余额",
#   "group": "tailnet",
#   "channel": "tailnet",
#   "url": "https://<mac-mini-host>.<tailnet>.ts.net:8448/",
#   "health": "/api/health",
#   "sensitivity": "normal",
#   "icon": "¥"
# }
